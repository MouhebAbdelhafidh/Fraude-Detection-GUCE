# Use a clean, slim Python base image
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies needed for specific pandas/numpy extensions
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy only requirements first to leverage Docker layer caching
COPY requirements.frontend.txt .
RUN pip install --no-cache-dir -r requirements.frontend.txt

# Copy the application source code from the deployment folder
COPY deployment/interface.py .
COPY deployment/graph_visualizer.py .

EXPOSE 8501

# Run healthcheck to ensure container is operational
HEALTHCHECK CMD curl --fail http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "interface.py", "--server.port=8501", "--server.address=0.0.0.0"]
